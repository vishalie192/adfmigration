{
	"name": "DS_COPYSQLTABLE_PARQUET",
	"properties": {
		"linkedServiceName": {
			"referenceName": "DS_COPYSQLTABLE_PARQUET",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"Schemaname": {
				"type": "string"
			},
			"Tablename": {
				"type": "string"
			}
		},
		"annotations": [],
